@INPROCEEDINGS{11043817,
  author={Kong, Yuyao and Jia, Jianwei and Lu, Anni and Waqar, Faaiq and Luo, Yuan-Chun and Li, Hai and Young, Ian and Yu, Shimeng},
  booktitle={2025 IEEE International Symposium on Circuits and Systems (ISCAS)}, 
  title={Digital Compute-in-Memory Ising Annealer with Ferroelectric Capacitor-Based nvSRAM for Combinatorial Optimization Problems}, 
  abbr={ISCAS},
  year={2025},
  month={May},
  volume={},
  number={},
  pages={1-5},
  abstract={Combinatorial optimization problems (COPs) have a wide range of applications. The Ising model-based annealer is gaining attention for its efficiency and speed in finding approximate solutions. However, building an Ising machine that is area- and energy-efficient, scalable, and with low compute latency in CMOS is challenging. In this paper, we present a digital compute-in-memory (DCIM) Ising annealer that uses ferroelectric capacitor (FeCap)-based nvSRAM to solve COPs like the Traveling Salesman Problem (TSP). By using weak recall operations, our design eliminates the need to reload weights, significantly reducing energy consumption and speeding up processing compared to other approaches. Simulations using a 16nm PDK demonstrate that our nvSRAM-based DCIM array maintains accuracy while reducing latency by up to 55.0% and energy by 49.6% compared to prior work implemented with conventional SRAM DCIM array. Algorithm validation further shows that the random noise introduced by weak recall can be effectively utilized in the annealing process.},
  keywords={Semiconductor device modeling;Annealing;Computational modeling;Noise;Random access memory;Simulated annealing;Traveling salesman problems;In-memory computing;Integrated circuit modeling;Optimization;Combinatorial optimization problem;simulated annealing;digital compute-in-memory;Ising model;ferroelectric;non-volatile SRAM},
  doi={10.1109/ISCAS56072.2025.11043817},
  google_scholar_id={9yKSN-GCB0IC}
  }

@ARTICLE{10852295,
  author={Vadlamani, Madhav and Jia, Jianwei and Xie, Tian and Luo, Yuan-Chun and Lee, Junmo and Li, Shaolan and Yu, Shimeng},
  journal={IEEE Electron Device Letters}, 
  title={Capacitive Crossbar Array for Solving Matrix Equations in One-Shot},
  abbr={EDL},
  year={2025},
  month={January},
  volume={46},
  number={3},
  pages={389-392},
  abstract={The resistive crossbar with a feedback loop has been proposed for solving matrix equations in a linear system with the current-domain computation. But the resistive approach suffers from high static power especially when the resistance is low. To overcome the challenges, we leverage C-V asymmetry in the ferroelectric capacitors of a crossbar array for the energy-efficient charge-domain computation. In this work, we demonstrate that such a capacitive crossbar when operated in negative feedback could solve the matrix problem  $Ax = {b}$  where x is the unknown vector. A comparative study shows a much lower power consumption (~1000 $\times $ ) for such a matrix solver when compared to the resistive crossbar counterpart.},
  keywords={Capacitors;Capacitance;Vectors;Power demand;Voltage measurement;Voltage;Accuracy;Mathematical models;Switches;Noise;Matrix equations;crossbar;HZO nvCap;charge domain;negative feedback loop},
  doi={10.1109/LED.2025.3533607},
  google_scholar_id={d1gkVwhDpl0C}
  }


