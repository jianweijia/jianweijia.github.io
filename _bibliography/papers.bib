  author={Jia, Jianwei and Jia, Zhenge and Phadke, Omkar and Choe, Gihun and Shi, Yiyu and Yu, Shimeng},
  booktitle={2024 IEEE 67th International Midwest Symposium on Circuits and Systems (MWSCAS)}, 
