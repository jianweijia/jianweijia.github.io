@INPROCEEDINGS{10.1145/3658617.3697677,
  author = {Huang*, Wei-Hsing and Jia*, Jianwei and Kong, Yuyao and Waqar, Faaiq and Wen, Tai-Hao and Chang, Meng-Fan and Yu, Shimeng},
  title = {Hardware Acceleration of Kolmogorov-Arnold Network (KAN) for Lightweight Edge Inference},
  year = {2025},
  month={January},
  isbn = {9798400706356},
  publisher = {Association for Computing Machinery},
  address = {New York, NY, USA},
  url = {https://doi.org/10.1145/3658617.3697677},
  doi = {10.1145/3658617.3697677},
  abstract = {Recently, a novel model named Kolmogorov-Arnold Networks (KAN) has been proposed with the potential to achieve the functionality of traditional deep neural networks (DNNs) using orders of magnitude fewer parameters by parameterized B-spline functions with trainable coefficients. However, the B-spline functions in KAN present new challenges for hardware acceleration. Evaluating the B-spline functions can be performed by using lookup tables (LUTs) to directly map the B-spline functions, thereby reducing computational resource requirements. However, this method still requires substantial circuit resources (LUTs, MUXs, decoders, etc.). For the first time, this paper employs an algorithm-hardware co-design methodology to accelerate KAN. The proposed algorithm-level techniques include Alignment-Symmetry and PowerGap KAN hardware aware quantization, KAN sparsity aware mapping strategy, and circuit-level techniques include N:1 Time Modulation Dynamic Voltage input generator with analog-CIM (ACIM) circuits. The impact of non-ideal effects, such as partial sum errors caused by the process variations, has been evaluated with the statistics measured from the TSMC 22nm RRAM-ACIM prototype chips. With the best searched hyperparameters of KAN and the optimized circuits implemented in 22 nm node, we can reduce hardware area by 41.78x, energy by 77.97x with 3.03\% accuracy boost compared to the traditional DNN hardware.},
  booktitle = {Proceedings of the 30th Asia and South Pacific Design Automation Conference},
  abbr={ASPDAC},
  pages = {693-699},
  numpages = {7},
  keywords = {kolmogorov-arnold networks (KAN), quantization, KAN aware quantization, KAN quantization, KAN sparsity aware weight mapping, compute-in-memory, algorithm-hardware co-design, software-hardware co-design},
  location = {Tokyo, Japan},
  series = {ASPDAC '25},
  google_scholar_id={u-x6o8ySG0sC}
}

