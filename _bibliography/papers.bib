@INPROCEEDINGS{10.1145/3658617.3697677,
  author = {Huang*, Wei-Hsing and Jia*, Jianwei and Kong, Yuyao and Waqar, Faaiq and Wen, Tai-Hao and Chang, Meng-Fan and Yu, Shimeng},
  title = {Hardware Acceleration of Kolmogorov-Arnold Network (KAN) for Lightweight Edge Inference},
