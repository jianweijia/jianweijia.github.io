<div class="col">
  <a href="{{ chip.url | relative_url }}">
    <div class="card h-100 hoverable chip-strip">
      <div class="row g-0">
        <div class="col-md-5 chip-strip-media">
          {% if chip.img_gds or chip.img_die %}
            <div class="row g-0">
              {% if chip.img_gds %}
                <div class="{% if chip.img_die %}col-6{% else %}col-12{% endif %}">
                  {%
                    include figure.liquid
                    loading="eager"
                    path=chip.img_gds
                    sizes="200px"
                    alt="GDS layout"
                    class="card-img"
                  %}
                  <p class="text-center small text-muted mb-0">GDS</p>
                </div>
              {% endif %}
              {% if chip.img_die %}
                <div class="{% if chip.img_gds %}col-6{% else %}col-12{% endif %}">
                  {%
                    include figure.liquid
                    loading="eager"
                    path=chip.img_die
                    sizes="200px"
                    alt="Die photo"
                    class="card-img"
                  %}
                  <p class="text-center small text-muted mb-0">Die Photo</p>
                </div>
              {% endif %}
            </div>
          {% elsif chip.img %}
            {%
              include figure.liquid
              loading="eager"
              path=chip.img
              sizes="250px"
              alt="chip photo"
              class="card-img"
            %}
          {% endif %}
        </div>
        <div class="col-md-7 d-flex align-items-center">
          <div class="card-body">
            <h2 class="card-title">{{ chip.title }}</h2>
            {% if chip.tech or chip.year %}
              <p class="card-text">
                {% if chip.tech -%}
                  <span class="badge badge-pill badge-secondary">{{ chip.tech }}</span>
                {%- endif %}
                {% if chip.year -%}
                  <span class="badge badge-pill badge-secondary">{{ chip.year }}</span>
                {%- endif %}
              </p>
            {% endif %}
            <p class="card-text">{{ chip.description }}</p>
          </div>
        </div>
      </div>
    </div>
  </a>
</div>
